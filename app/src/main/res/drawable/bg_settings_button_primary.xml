<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#7C2CFF" android:endColor="#1EA7FF" />
            <stroke android:width="2dp" android:color="#B57C4DFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#5C2EEB" android:endColor="#1677FF" />
            <stroke android:width="1dp" android:color="#8F63D9FF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
