<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#090D19">

    <ImageView
        android:id="@+id/full_keyboard_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/keyboard_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="4dp">

        <LinearLayout
            android:id="@+id/smart_reply_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/smart_reply_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/smart_reply_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/smart_reply_insert_anyway"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Insert"
                android:textAllCaps="false"
                android:visibility="gone" />

            <Button
                android:id="@+id/smart_reply_replace"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Replace"
                android:textAllCaps="false"
                android:visibility="gone" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/keyboard_toolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="2dp">

                <Button
                    android:id="@+id/toolbar_ai"
                    android:layout_width="52dp"
                    android:layout_height="48dp"
                    android:text="AI"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/toolbar_language"
                    android:layout_width="72dp"
                    android:layout_height="48dp"
                    android:text="EN"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/toolbar_bangla_mode"
                    android:layout_width="78dp"
                    android:layout_height="48dp"
                    android:text="Phonetic"
                    android:textAllCaps="false"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/toolbar_emoji"
                    android:layout_width="52dp"
                    android:layout_height="48dp"
                    android:text="☺"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/toolbar_clipboard"
                    android:layout_width="52dp"
                    android:layout_height="48dp"
                    android:text="📋"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/toolbar_voice"
                    android:layout_width="52dp"
                    android:layout_height="48dp"
                    android:text="🎤"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/toolbar_settings"
                    android:layout_width="52dp"
                    android:layout_height="48dp"
                    android:text="⚙"
                    android:textAllCaps="false" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/suggestion_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/ai_panel_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ai_panel_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/keyboard_panel_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/keys_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/keys_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/keyboard_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/bubble_key_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:clipChildren="false"
        android:clipToPadding="false" />
</FrameLayout>
