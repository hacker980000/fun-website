<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_settings_root"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/settings_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="22dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/settings_header_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings Menu"
            android:textColor="#F8FAFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settings_header_eyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Your Keyboard • Your Way"
            android:textColor="#7DE2FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settings_header_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Choose a settings category to open its dedicated controls."
            android:textColor="#9EABCA"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/status_settings_theme"
            style="@style/SetupStatusRow"
            android:layout_marginTop="14dp"
            android:text="Settings theme: Clean Modern" />

        <LinearLayout
            android:id="@+id/settings_theme_dashboard_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
